{
  "version": "1.0",
  "name": "occupancy-reconciliation",
  "description": "High-throughput batch reconciliation pipeline processing CSV/JSON barrier gate logs, session tickets, and ANPR records to resolve inconsistencies across physical and digital parking states",
  "metadata": {
    "author": "ParkNex AI Architecture Team",
    "target": "RocketRide Engine 2.0",
    "domain": "Batch Parking Data Audit"
  },
  "nodes": [
    {
      "id": "batch_records_input",
      "provider": "input",
      "config": {
        "schema": {
          "type": "object",
          "properties": {
            "facilityId": { "type": "string" },
            "batchSource": { "type": "string" },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "recordId": { "type": "string" },
                  "vehicleNumber": { "type": "string" },
                  "eventType": { "type": "string" },
                  "timestamp": { "type": "string" },
                  "gate": { "type": "string" },
                  "slotId": { "type": "string" },
                  "confidence": { "type": "number" }
                },
                "required": ["vehicleNumber", "eventType", "timestamp"]
              }
            }
          },
          "required": ["facilityId", "records"]
        }
      }
    },
    {
      "id": "batch_sanitizer_validator",
      "provider": "transform",
      "config": {
        "type": "batch_parser",
        "parameters": {
          "isolateCorruptedRows": true,
          "normalizePlates": true,
          "deduplicateWithinBatch": true
        }
      },
      "input": "batch_records_input"
    },
    {
      "id": "batch_reconciliation_intelligence",
      "provider": "llm",
      "config": {
        "model": "gemini-2.5-flash",
        "temperature": 0.1,
        "systemPrompt": "You are the ParkNex Batch Reconciliation Specialist. Reconcile entry events, exit events, and slot states. Identify unmatched entries, unclosed exits, double entries, and phantom parking. Return a summary object: { recordsReceived, recordsProcessed, validRecords, invalidRecords, anomaliesDetected, recordsRequiringReview, failedRecords, executionDurationMs, results: [ { recordId, vehicleNumber, status, anomalyType, severity, explanation, actionRequired } ] }."
      },
      "input": "batch_sanitizer_validator"
    },
    {
      "id": "batch_integrity_validator",
      "provider": "validator",
      "config": {
        "preventBatchCrashOnRowError": true,
        "maxBatchSize": 5000
      },
      "input": "batch_reconciliation_intelligence"
    },
    {
      "id": "reconciliation_sink",
      "provider": "output",
      "config": {
        "format": "json"
      },
      "input": "batch_integrity_validator"
    }
  ],
  "edges": [
    { "from": "batch_records_input", "to": "batch_sanitizer_validator" },
    { "from": "batch_sanitizer_validator", "to": "batch_reconciliation_intelligence" },
    { "from": "batch_reconciliation_intelligence", "to": "batch_integrity_validator" },
    { "from": "batch_integrity_validator", "to": "reconciliation_sink" }
  ]
}
