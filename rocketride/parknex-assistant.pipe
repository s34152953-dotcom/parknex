{
  "version": "1.0",
  "name": "parknex-assistant",
  "description": "Context-grounded contextual conversational assistant for drivers and parking operators querying verified real-time database state with zero hallucination guarantee",
  "metadata": {
    "author": "ParkNex AI Architecture Team",
    "target": "RocketRide Engine 2.0",
    "domain": "Conversational Smart Mobility"
  },
  "nodes": [
    {
      "id": "assistant_query_input",
      "provider": "input",
      "config": {
        "schema": {
          "type": "object",
          "properties": {
            "query": { "type": "string" },
            "userRole": { "type": "string", "enum": ["CUSTOMER", "ADMIN"] },
            "userEmail": { "type": "string" },
            "context": {
              "type": "object",
              "properties": {
                "activeBooking": { "type": "object" },
                "facilityStats": { "type": "object" },
                "availableSlots": { "type": "array" },
                "recentAnomalies": { "type": "array" }
              }
            }
          },
          "required": ["query", "userRole", "context"]
        }
      }
    },
    {
      "id": "grounding_context_injector",
      "provider": "transform",
      "config": {
        "type": "context_grounding",
        "parameters": {
          "strictFactChecking": true,
          "blockUnverifiedClaims": true
        }
      },
      "input": "assistant_query_input"
    },
    {
      "id": "assistant_intelligence",
      "provider": "llm",
      "config": {
        "model": "gemini-2.5-flash",
        "temperature": 0.2,
        "systemPrompt": "You are ParkNex AI, an intelligent, professional parking intelligence assistant for drivers and facility operators. Answer queries using ONLY the verified context provided. Never fabricate vehicle locations, parking spaces, occupancy, session details, user information, or analytics. If information cannot be verified from the current ParkNex data, respond with: 'I couldn't verify that information from the current ParkNex data.'"
      },
      "input": "grounding_context_injector"
    },
    {
      "id": "anti_hallucination_guard",
      "provider": "validator",
      "config": {
        "checkGroundingAgainstContext": true,
        "fallbackPhrase": "I couldn't verify that information from the current ParkNex data."
      },
      "input": "assistant_intelligence"
    },
    {
      "id": "assistant_sink",
      "provider": "output",
      "config": {
        "format": "json"
      },
      "input": "anti_hallucination_guard"
    }
  ],
  "edges": [
    { "from": "assistant_query_input", "to": "grounding_context_injector" },
    { "from": "grounding_context_injector", "to": "assistant_intelligence" },
    { "from": "assistant_intelligence", "to": "anti_hallucination_guard" },
    { "from": "anti_hallucination_guard", "to": "assistant_sink" }
  ]
}
