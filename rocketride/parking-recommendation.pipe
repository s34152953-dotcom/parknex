{
  "components": [
    {
      "id": "input_1",
      "provider": "webhook",
      "config": {
        "description": "Ingests customer destination, accessibility preferences, and list of currently available parking spaces from database"
      },
      "ui": {
        "position": { "x": 100, "y": 150 },
        "measured": { "width": 160, "height": 70 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "transform_1",
      "provider": "transform",
      "config": {
        "description": "Filters candidate bays against vehicle constraints, computes landmark proximity vectors, and calculates zone congestion weights"
      },
      "input": [
        { "lane": "text", "from": "input_1" }
      ],
      "ui": {
        "position": { "x": 340, "y": 150 },
        "measured": { "width": 160, "height": 70 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "evaluator_1",
      "provider": "llm_openai",
      "config": {
        "model": "gpt-4o-mini",
        "temperature": 0.2,
        "systemPrompt": "You are the ParkNex Spatial Parking Recommender. Given customer destination, accessibility constraints, and verified live available spaces, rank the top 3 optimal bays. Return a JSON structure with recommendedSlots: array of { parkingSpaceId, zone, rank (1-3), confidence (0.00-1.00), reason, relativeConvenience }. Only rank spaces provided in the input list; never invent nonexistent parking spaces."
      },
      "input": [
        { "lane": "text", "from": "transform_1" }
      ],
      "ui": {
        "position": { "x": 580, "y": 150 },
        "measured": { "width": 160, "height": 70 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "response_1",
      "provider": "response_text",
      "config": {
        "description": "Emits ranked top 3 parking space recommendations with confidence score and navigation rationale"
      },
      "input": [
        { "lane": "text", "from": "evaluator_1" }
      ],
      "ui": {
        "position": { "x": 820, "y": 150 },
        "measured": { "width": 160, "height": 70 },
        "nodeType": "default",
        "formDataValid": true
      }
    }
  ],
  "project_id": "f31c8902-3e2a-4a8b-9d41-791f456ba128",
  "viewport": { "x": 0, "y": 0, "zoom": 1 },
  "version": 1
}
