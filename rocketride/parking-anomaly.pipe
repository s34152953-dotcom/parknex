{
  "components": [
    {
      "id": "input_1",
      "provider": "webhook",
      "config": {
        "description": "Receives parking facility state, active sessions, slot statuses, and gate entry/exit events"
      },
      "ui": {
        "position": { "x": 100, "y": 150 },
        "measured": { "width": 160, "height": 70 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "transform_1",
      "provider": "transform",
      "config": {
        "description": "Correlates active vehicle sessions, spatial slot states, gate entry/exit events to detect duplicate assignments, phantom occupancies, and timing violations"
      },
      "input": [
        { "lane": "text", "from": "input_1" }
      ],
      "ui": {
        "position": { "x": 340, "y": 150 },
        "measured": { "width": 160, "height": 70 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "evaluator_1",
      "provider": "llm_openai",
      "config": {
        "model": "gpt-4o-mini",
        "temperature": 0.1,
        "systemPrompt": "You are the ParkNex Parking Integrity & Anomaly Auditor. Analyze discrepancies across parking allocations, barrier events, and slot states. Return a structured JSON anomaly report with fields: anomalyDetected (boolean), type (duplicate_space_assignment, multiple_active_sessions, unregistered_entry, missing_checkout, phantom_occupancy, slot_state_mismatch, invalid_zone_relationship, excessive_duration, duplicate_barrier_event), severity (low, medium, high, critical), confidence (0.00 to 1.00), explanation, recommendedAction, and reviewRequired (boolean). High and critical severity anomalies must always set reviewRequired to true."
      },
      "input": [
        { "lane": "text", "from": "transform_1" }
      ],
      "ui": {
        "position": { "x": 580, "y": 150 },
        "measured": { "width": 160, "height": 70 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "response_1",
      "provider": "response_text",
      "config": {
        "description": "Outputs structured anomaly classification with confidence score and human-in-the-loop review trigger"
      },
      "input": [
        { "lane": "text", "from": "evaluator_1" }
      ],
      "ui": {
        "position": { "x": 820, "y": 150 },
        "measured": { "width": 160, "height": 70 },
        "nodeType": "default",
        "formDataValid": true
      }
    }
  ],
  "project_id": "c73b1842-8e4a-4a2b-9271-468e82d1c905",
  "viewport": { "x": 0, "y": 0, "zoom": 1 },
  "version": 1
}
