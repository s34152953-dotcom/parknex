{
  "components": [
    {
      "id": "input_1",
      "provider": "webhook",
      "config": {
        "description": "Receives parking check-in vehicle event with plate, facility, zone, pillar, and space allocation"
      },
      "ui": {
        "position": { "x": 100, "y": 150 },
        "measured": { "width": 160, "height": 70 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "transform_1",
      "provider": "transform",
      "config": {
        "description": "Normalize vehicle plate characters, enforce Indian registration regex, check zone spatial allocation"
      },
      "input": [
        { "lane": "text", "from": "input_1" }
      ],
      "ui": {
        "position": { "x": 340, "y": 150 },
        "measured": { "width": 160, "height": 70 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "evaluator_1",
      "provider": "llm_openai",
      "config": {
        "model": "gpt-4o-mini",
        "temperature": 0.1,
        "systemPrompt": "You are the ParkNex AI Parking Verification Engine. Validate the vehicle license plate, facility, zone, and slot allocation. Score verification confidence between 0.00 and 1.00. Output strict JSON with verificationStatus (VERIFIED, INVALID, MISMATCH, UNAVAILABLE), confidence (0.00-1.00), explanation, reviewRequired (boolean), and recommendedAction."
      },
      "input": [
        { "lane": "text", "from": "transform_1" }
      ],
      "ui": {
        "position": { "x": 580, "y": 150 },
        "measured": { "width": 160, "height": 70 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "response_1",
      "provider": "response_text",
      "config": {
        "description": "Emits validated parking check-in verification result with confidence score and human-in-the-loop review trigger"
      },
      "input": [
        { "lane": "text", "from": "evaluator_1" }
      ],
      "ui": {
        "position": { "x": 820, "y": 150 },
        "measured": { "width": 160, "height": 70 },
        "nodeType": "default",
        "formDataValid": true
      }
    }
  ],
  "project_id": "a24c8b91-7d3e-4f1a-b602-98e1f574d320",
  "viewport": { "x": 0, "y": 0, "zoom": 1 },
  "version": 1
}
