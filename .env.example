# ==============================================================================
# ParkNex Smart Parking System - Environment Configuration
# ==============================================================================

# 1. Convex Real-Time Backend
CONVEX_DEPLOYMENT=agreeable-tapir-530
NEXT_PUBLIC_CONVEX_URL=https://agreeable-tapir-530.convex.cloud

# 2. NextAuth Authentication
AUTH_SECRET=your_super_secret_auth_key_minimum_32_characters_long
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# 3. Resend Transactional Email Notification Service
RESEND_API_KEY=
PARKNEX_EMAIL_FROM="ParkNex <onboarding@resend.dev>"
PARKNEX_APP_URL="https://parknex.vercel.app"

# 4. TextBee Android SMS Gateway (Free Android Phone + SIM)
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_textbee_android_device_id_here

# 5. Cryptographic Security & Pass Signing
PASS_SIGNING_SECRET=your_hmac_sha256_pass_signing_secret_do_not_share
OTP_PEPPER=your_crypto_pepper_for_unique_codes_2026

# 6. Python Edge AI & CCTV Daemon
AI_EDGE_API_URL=http://localhost:8000
AI_EDGE_SHARED_SECRET=PARKNEX_EDGE_AI_SHARED_SECRET_2026
CONVEX_HTTP_URL=https://agreeable-tapir-530.convex.site

# 7. MediaMTX RTSP-to-WebRTC/HLS Streaming Bridge
NEXT_PUBLIC_MEDIAMTX_WEBRTC_URL=http://localhost:8889
NEXT_PUBLIC_MEDIAMTX_HLS_URL=http://localhost:8888

# 8. RocketRide AI Pipeline Engine (Server-Side Only - Never expose to client)
ROCKETRIDE_URI=https://api.rocketride.ai
ROCKETRIDE_APIKEY=your_rocketride_api_key_secret
AI_REVIEW_CONFIDENCE_THRESHOLD=0.85

